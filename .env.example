# Copy to .env. Never commit .env. All values below are placeholders.
BFF_PORT=8790
LLM_MODE=live
SESSION_SECRET=replace-with-a-long-random-string
# DB_FILE=./data/app.db
# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Circle developer sandbox
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Optional live keys. Live mode is refused without them.
# STRIPE_LIVE_SECRET_KEY=
# CIRCLE_LIVE_API_KEY=
# CIRCLE_LIVE_ENTITY_SECRET=
# ONCHAIN_LIVE_PRIVATE_KEY=
# RAIL_POLL_MS=5000

# Sign in. DEMO_LOGIN=1 shows the no password demo users. OIDC_* seed the platform identity provider once.
DEMO_LOGIN=1
OIDC_ISSUER=http://localhost:8180/realms/b2bpay
OIDC_CLIENT_ID=b2bpay-web
OIDC_CLIENT_SECRET=
PUBLIC_URL=http://localhost:5180
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
